# ============================================================================
# CrewMesh — Environment Configuration Example (Batch 3)
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit a real .env file or production credentials to version control.
# ============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Public origin of the web frontend (used for strict same-origin CSRF checks)
APP_ORIGIN=http://localhost:5173

# PostgreSQL connection strings
DATABASE_URL=postgresql://crewmesh:crewmesh_local_dev_password@localhost:5432/crewmesh_dev
TEST_DATABASE_URL=postgresql://crewmesh:crewmesh_local_dev_password@localhost:5432/crewmesh_test
DB_POOL_MAX=25

# Security & Session configuration (replace with >= 32 random bytes in production)
SESSION_COOKIE_NAME=crewmesh_session
SESSION_TTL_HOURS=168
CSRF_SECRET=replace_with_at_least_32_characters_of_random_entropy_for_csrf_hmac

# Proxy trust (set to true ONLY when running behind a known reverse proxy)
TRUST_PROXY=false

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Simulated Hack4Hack 2026 event seed parameters
# Leave HACKATHON_DEADLINE_ISO empty/unset so registration_deadline is NULL unless
# an explicit event registration deadline is configured.
HACKATHON_SLUG=hack4hack-crew-2026
HACKATHON_NAME=Hack4Hack Crew Hiring Challenge 2026
HACKATHON_MIN_TEAM_SIZE=2
HACKATHON_MAX_TEAM_SIZE=5
HACKATHON_DEADLINE_ISO=
